{
  "dependencies": ["."],
  "graphs": {
    "healthcare_rag": "./healthcare_rag/graph/__init__.py:graph",
    "coach": "./healthcare_rag/agent/__init__.py:coach"
  },
  "store": {
    "index": {
      "embed": "openai:text-embedding-3-small",
      "dims": 1536,
      "fields": ["$"]
    }
  },
  "auth": {
    "path": "./healthcare_rag/agent/auth.py:auth",
    "disable_studio_auth": true
  },
  "http": {
    "app": "./healthcare_rag/agent/http_app.py:app",
    "middleware_order": "auth_first",
    "enable_custom_route_auth": true,
    "disable_mcp": true,
    "disable_a2a": true
  },
  "env": ".env",
  "python_version": "3.12",
  "dockerfile_lines": [
    "ENV PRESIDIO_DEVICE=cpu"
  ]
}
