import asyncio, json, httpx
from server.assistants import routes as a_routes
from server.store_routes import routes as s_routes
from server.config import ServerConfig
from server.storage import Storage
from server.auth import AuthPolicyEngine, AuthMiddleware
from langgraph_sdk import Auth
from starlette.applications import Starlette
from langgraph.store.memory import InMemoryStore
from langgraph.checkpoint.memory import InMemorySaver

# Build stub auth
from langgraph_sdk import Auth as A

auth=A()
@auth.authenticate
async def authenticate(method, path, headers, authorization):
    if authorization == "Bearer good":
        return {"identity": "member-1", "is_authenticated": True, "role": "member"}
    raise A.exceptions.HTTPException(status_code=401)
@auth.on
async def deny_all(ctx, value):
    del value
    kind = ctx.user["kind"] if "kind" in ctx.user else None
    return None if kind == "StudioUser" else False
@auth.on.assistants.read
async def r(ctx, value):
    del value
    if ctx.user.get("kind") == "StudioUser":
        return None
    return {"graph_id": "coach"}
@auth.on.assistants.search
async def sr(ctx, value):
    del value
    if ctx.user.get("kind") == "StudioUser":
        return None
    return {"graph_id": "coach"}

cfg = ServerConfig(graphs={"healthcare_rag": "./healthcare_rag/graph/__init__.py:graph", "coach": "./healthcare_rag/agent/__init__.py:coach"}, auth_path=None, http_app=None, http_flags={}, store_index={}, api_version="0.12.6", storage="memory", port=8000, local_dev=False, raw={})

class Fake:
    def embed_documents(self, texts):
        out=[]
        for t in texts:
            low=t.lower()
            if "cats" in low or "meow" in low: out.append([1,0,0])
            elif "dogs" in low or "bark" in low: out.append([0,1,0])
            else: out.append([0,0,1])
        return out
    def embed_query(self, t): return self.embed_documents([t])[0]
    async def aembed_documents(self, texts): return self.embed_documents(texts)
    async def aembed_query(self, t): return self.embed_query(t)

store = InMemoryStore(index=None)
store.index_config={"embed":"fake","dims":3,"fields":["$"],"__tokenized_fields":[("$","$")]}
store.embeddings=Fake()
storage = Storage(saver=InMemorySaver(), store=store)
routes = a_routes + s_routes
app = Starlette(routes=routes, middleware=[AuthMiddleware.as_starlette(auth, local_dev=True)])
app.state.config=cfg; app.state.storage=storage; app.state.auth_engine=AuthPolicyEngine(auth)
class R:
    def is_ready(self): return True
app.state.readiness=R()

async def run():
    async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url="http://test") as client:
        r = await client.post("/assistants/search", json={})
        print("Studio assistants search:", r.status_code, json.dumps(r.json(), indent=2))
        r2 = await client.put("/store/items", json={"namespace": ["test","qa"], "key": "k1", "value": {"text": "cats meow"}})
        print("PUT k1:", r2.status_code)
        r3 = await client.put("/store/items", json={"namespace": ["test","qa"], "key": "k2", "value": {"text": "dogs bark"}})
        print("PUT k2:", r3.status_code)
        r4 = await client.get("/store/items", params={"namespace":"test.qa","key":"k1"})
        print("GET k1:", r4.status_code, r4.json())
        r5 = await client.post("/store/items/search", json={"namespace_prefix":["test","qa"], "query":"cats", "limit":10})
        print("SEARCH cats:", r5.status_code, json.dumps(r5.json(), indent=2))
        r6 = await client.put("/store/items", json={"namespace":["bad.label"], "key":"k","value":{"x":1}})
        print("MALFORMED:", r6.status_code, r6.json())
        r7 = await client.get("/store/items", params={"namespace":"nope","key":"missing"})
        print("MISSING:", r7.status_code, r7.json())
import anyio
anyio.run(run)
