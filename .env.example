# Environment variables for healthcare-rag — copy to .env (gitignored) and fill in.

# Required: OpenAI (LLMs + Weaviate's text2vec-openai vectorizer)
OPENAI_API_KEY="your_openai_api_key_here"

# Optional: LangSmith tracing + evals (evals/ needs LANGSMITH_API_KEY)
# Keep tracing off for normal healthcare queries. Opt in only with synthetic or
# de-identified input, and keep LANGSMITH_HIDE_INPUTS=true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY="lsv2_..."
LANGSMITH_PROJECT=healthcare-rag
LANGSMITH_HIDE_INPUTS=true

# Required for the authenticated Coach Agent Server surface.
# All values below are server-only except the two explicitly NEXT_PUBLIC variables.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
COACH_INTERNAL_TOKEN="generate_a_separate_high_entropy_secret"
COACH_ALLOWED_ORIGINS="http://localhost:3000"
# Keep the Agent Server's native-route CORS policy aligned with COACH_ALLOWED_ORIGINS.
CORS_ALLOW_ORIGINS="http://localhost:3000"
LANGSMITH_FEEDBACK_PROJECT_ID="00000000-0000-4000-8000-000000000000"
LANGGRAPH_DEPLOYMENT_URL="https://your-deployment.us.langgraph.app"

# Optional: model selection (see healthcare_rag/services/models.py)
# HC_RAG_LLM_MODEL=gpt-5.6-luna
# HC_RAG_VALIDATOR_MODEL=gpt-5.6-terra
# HC_RAG_REASONING_EFFORT=none

# Optional: runtime safety gate (see healthcare_rag/processors/safety.py, docs/safety.md)
# HC_RAG_SAFETY_GATE=true            # classify + scrub PHI before the pipeline; false = un-gated (ablation)
# HC_RAG_REFUSAL_BOUNDARY=true  # persist gate refusals per thread and replay them deterministically on matching re-asks
# HC_RAG_DISABLE_STAGES=safety       # same effect via the generic stage switch

# Optional: routing-experiment controls (defaults preserve the existing runtime).
# HC_RAG_QUERY_RESPONSE_ARM=current  # current keeps the established scope response for benign social turns;
                                      # deterministic serves fixed greeting/thanks/goodbye/capability text;
                                      # tool permits a tool-bound social decision but never direct medical output
# HC_RAG_SAFETY_CLASSIFIER=llm        # required default. Do not select semantic_router: semantic-router==0.1.16
                                      # is dependency-INCONCLUSIVE with the unchanged openai/python-dotenv bounds.

# Optional: stage ablation (healthcare_rag/services/models.py). Comma-separated;
# valid values: safety, clarify, decompose, evaluate, validate, followups.
# Disabled stages pass through and make no LLM call (unknown values raise).
# HC_RAG_DISABLE_STAGES=validate

# Optional: decomposition (see healthcare_rag/services/models.py)
# HC_RAG_MAX_SUBQUERIES=3            # cap on sub-query branches per decomposition
# HC_RAG_DECOMPOSE_ONLY_COMPLEX=true # only decompose when the decomposer says 'complex'

# Optional: graph engine (see healthcare_rag/graph/settings.py)
# HC_RAG_CHECKPOINT=sqlite:/tmp/hc_rag_threads.db  # default: in-memory (no cross-restart threads);
                                                    # needs the graph-sqlite extra for sqlite
# HC_RAG_HISTORY_MAX_TOKENS=4000     # token cap applied to conversation-history views
# HC_RAG_STRUCTURED_STRICT=false     # strict=true for all structured-output stages

# Optional: Pinecone A/B retrieval arm + reranker (see healthcare_rag/services/models.py).
# PINECONE_API_KEY is a *required secret* for both — every Pinecone path raises without it.
# PINECONE_API_KEY="pcsk_..."
# HC_RAG_RETRIEVER=pinecone          # weaviate (default) | pageindex | pinecone
# HC_RAG_RERANKER=pinecone           # none (default) | pinecone — reranks the wider candidate set
# HC_RAG_RERANK_CANDIDATES=12        # documents fetched per collection when reranking
# HC_RAG_RERANK_TOP_K=4              # documents kept after reranking (= the un-reranked limit)
# HC_RAG_RERANK_MODEL=bge-reranker-v2-m3
# HC_RAG_PINECONE_INDEX=healthcare-rag        # load it with `make ingest-pinecone`
# HC_RAG_PINECONE_ALPHA=0.65         # dense/sparse convex-scaling weight (matches Weaviate's alpha)
# PINECONE_CLOUD=aws                 # serverless placement, used only at index creation
# PINECONE_REGION=us-east-1

# Optional: Weaviate connection (defaults to 127.0.0.1:8080 / 50051)
# WEAVIATE_HOST=127.0.0.1
# WEAVIATE_PORT=8080
# WEAVIATE_GRPC_PORT=50051

# Server — OSS Agent Server (see server/config.py, deploy/fly.prod.toml)
# SERVER_STORAGE=memory            # only 'memory' this stage (no persistence)
# SERVER_PORT=8000                 # default 8000; server-dev uses 2024
# SERVER_LOCAL_DEV=1               # DEV ONLY — enables StudioUser bypass for local dev; NEVER set in production/Fly (default off)
# LANGGRAPH_DEPLOYMENT_URL is the Fly prod URL post-deploy, e.g. https://hc-rag-server-prod.fly.dev
# NEXT_PUBLIC_LANGGRAPH_URL="https://hc-rag-server-prod.fly.dev"  # frontend — must match LANGGRAPH_DEPLOYMENT_URL
