# Environment variables for healthcare-rag — copy to .env (gitignored) and fill in.

# Required: OpenAI (LLMs + Weaviate's text2vec-openai vectorizer)
OPENAI_API_KEY="your_openai_api_key_here"

# Recommended: LangSmith tracing + evals (evals/ needs LANGSMITH_API_KEY)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="lsv2_..."
LANGSMITH_PROJECT=healthcare-rag
# LANGSMITH_HIDE_INPUTS=true    # recommended when tracing real queries: the safety-gate
                                # node's own child-trace input still contains the raw
                                # question during execution (see docs/safety.md residuals)

# Optional: model selection (see healthcare_rag/services/models.py)
# HC_RAG_LLM_MODEL=gpt-5.6-luna
# HC_RAG_VALIDATOR_MODEL=gpt-5.6-terra
# HC_RAG_REASONING_EFFORT=none

# Optional: runtime safety gate (see healthcare_rag/processors/safety.py, docs/safety.md)
# HC_RAG_SAFETY_GATE=true            # classify + scrub PHI before the pipeline; false = un-gated (ablation)
# HC_RAG_REFUSAL_BOUNDARY=true  # persist gate refusals per thread and replay them deterministically on matching re-asks
# HC_RAG_DISABLE_STAGES=safety       # same effect via the generic stage switch

# Optional: stage ablation (healthcare_rag/services/models.py). Comma-separated;
# valid values: safety, clarify, decompose, evaluate, validate, followups.
# Disabled stages pass through and make no LLM call (unknown values raise).
# HC_RAG_DISABLE_STAGES=validate

# Optional: decomposition (see healthcare_rag/services/models.py)
# HC_RAG_MAX_SUBQUERIES=3            # cap on sub-query branches per decomposition
# HC_RAG_DECOMPOSE_ONLY_COMPLEX=true # only decompose when the decomposer says 'complex'

# Optional: graph engine (see healthcare_rag/graph/settings.py)
# HC_RAG_CHECKPOINT=sqlite:/tmp/hc_rag_threads.db  # default: in-memory (no cross-restart threads);
                                                    # needs the graph-sqlite extra for sqlite
# HC_RAG_HISTORY_MAX_TOKENS=4000     # token cap applied to conversation-history views
# HC_RAG_STRUCTURED_STRICT=false     # strict=true for all structured-output stages

# Optional: Weaviate connection (defaults to 127.0.0.1:8080 / 50051)
# WEAVIATE_HOST=127.0.0.1
# WEAVIATE_PORT=8080
# WEAVIATE_GRPC_PORT=50051
