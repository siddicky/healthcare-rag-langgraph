    {
      "id": "claim_1c9373f5bf47423db46aefd89787d3d9",
      "statement": "The same-turn scoping of catalog DataRefs is enforced structurally by a shared deterministic digest: coach_agent.py's _scope() computes sha256(thread_id|human_msg_id) from the server-derived AgentContext to validate a compose_ui call, while store_data.py's make_envelope() stamps the identical digest as turn_scope_id on every DATA envelope a tool emits for that turn, so validate_composition() only accepts refs whose turn_scope_id and block_id match an envelope actually present in the current request's tool messages.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/coach_agent.py#L80-L94",
          "version": "repo-lines-v1:sha256:c20f4e1f77226c81a4fcfdf0fb59ad21e22489af79aeace0ff0ac3c1092c2f18:"
