    {
      "id": "claim_cd1e646e9b28472192f83a38a04e5390",
      "statement": "medical_lookup is registered return_direct with response_format=content_and_artifact; relay_medical_answer (an after_agent hook) converts its terminal ToolMessage into an AIMessage containing exactly the tool content, and coach_agent copies only the tool artifact's follow_ups into graph state, so a medical answer is relayed verbatim and never restated by the model.",
      "evidence": [
