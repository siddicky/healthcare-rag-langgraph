    {
      "id": "claim_bd0e50141af644b5a08919a64c1d12ec",
      "statement": "The deployed coach graph, registered from healthcare_rag/agent/__init__.py and built by build_coach_graph(), has one deterministic entry node coach_gate and one terminal projection finalize; the gate decides only operational/safety paths and never classifies medical versus coaching questions or makes a model call.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/__init__.py",
          "version": "repo-file-v1:sha256:2b84195220c9bbb553c2b3ed8bc2f3ec75388bdca1ef1c1918487a431a7a8ab3"
        },
        {
