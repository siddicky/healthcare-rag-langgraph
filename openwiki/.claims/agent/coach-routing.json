          "version": "repo-file-v1:sha256:10d673bf93992d8f5a43c28936cc18cd29ffc94f184ce727fc7c913add9fb8d9"
        }
      ]
    },
    {
      "id": "claim_c7114b8d0976458a8401a73669346d96",
      "statement": "coach_gate() scrubs the raw question for PHI, clears the untracked question field, adds the scrubbed value as a HumanMessage, and resets follow_ups at the start of every turn, before applying its fixed-precedence routing.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/gate.py#L32-L44",
          "version": "repo-lines-v1:sha256:3988aa4c40692d48d6f6d4d5c89da1e178cda30c8ccd7b4685c0942cf05f9f7a:"
        }
      ]
    },
    {
      "id": "claim_4cce577e7df14497b7c5c86dac49409d",
      "statement": "coach_gate's routing precedence is: (1) a cron_wake, validated by requiring an active stored reminder with matching reminder/user/configured thread IDs and a constant-time wake-token comparison, routes to reminder_delivery when valid or short_circuit when invalid, clearing cron_wake either way; (2) any attachment_id routes to claim_document ahead of text safety or erasure checks; (3) deterministic red-flag terms, injection flags, or identifier-recall requests route to short_circuit; (4) a recognized erasure request routes to erase_my_data; (5) every remaining turn, including medical questions, enters coach_agent.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/gate.py#L45-L89",
          "version": "repo-lines-v1:sha256:86f76a4983e3f3b3e5b5489297e04eef434a64f5bf140abdccd129bff9e82f59:"
        }
      ]
    },
    {
      "id": "claim_d27b2a97901e4e869a532197596de196",
      "statement": "short_circuit() performs no model call: it derives the matching emergency, injection, identifier-recall, or out-of-scope fixed response from the last scrubbed human message and clears follow_ups, and it skips adding another AI message if one already exists in state.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/short_circuit.py",
          "version": "repo-file-v1:sha256:62a219dc355e817efe75ea1d93bcbf52d04474ebd0c47f623ffafb7c87e1c566"
        }
      ]
    },
    {
      "id": "claim_2ea590bc02a44f8bb2ca4112e3061ec1",
      "statement": "CoachOutput exposes only messages and follow_ups; question, attachment_id, cron_wake, and reminder_wake are untracked CoachState fields rather than checkpointed output data.",
      "evidence": [
        {
