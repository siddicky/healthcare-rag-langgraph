    {
      "id": "claim_7e383782852a41c9ab58ff26abb5dbb9",
      "statement": "Medical routing is model-driven, not a gate destination: the Route B system prompt instructs the model to call medical_lookup alone for medication dose, adverse-effect, interaction, warning, and monograph questions, prohibiting answers from model knowledge, diagnosis, or personal dosing advice.",
      "evidence": [
        {
