    {
      "id": "claim_467243d561344bc6a8e10e6887717c58",
      "statement": "coach_gate() is a fixed, non-LLM precedence list that first scrubs the incoming question into a HumanMessage, clears the raw question, resets follow-ups, then routes in order: cron wake, attachment presence, deterministic red-flag/injection/identifier-recall signals, erase phrasing, and otherwise coach_agent for every remaining turn including medical questions.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/gate.py#L32-L89",
          "version": "repo-lines-v1:sha256:853b872a6addc9e10981f26ee42889e5a37e3de6f9bc9441957177cefefc78ce:"
