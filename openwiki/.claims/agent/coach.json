  "claims": [
    {
      "id": "claim_0da4593d52774b659464266d0a08b131",
      "statement": "The coach graph is a separate LangGraph StateGraph from the healthcare_rag graph: it defines its own CoachState/CoachInput/CoachOutput contract, is built by build_coach_graph(), and is compiled and named 'coach', not a variant of the healthcare RAG graph.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/build.py#L1-L56",
          "version": "repo-lines-v1:sha256:9bb47ffde06b3dd04c503fc609a3590017809b452dd98759460e35c816afe883:"
        },
        {
          "resource": "repo://healthcare_rag/agent/state.py#L1-L36",
