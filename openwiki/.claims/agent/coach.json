    {
      "id": "claim_e9f0152602644c4083f1a705b6279df7",
      "statement": "Fact-bearing compose_ui props must be __ref objects naming a turn_scope_id, block_id, and RFC-6901-style pointer that resolve within the current turn's tool DATA envelopes; validation rejects unknown components/props, malformed or cross-turn references, missing blocks/pointers, and JSON-type mismatches, while static props are restricted to an allowlist of copy, dispatch ids, and enums so literal numeric or clinical-looking values cannot be injected as static text.",
      "evidence": [
