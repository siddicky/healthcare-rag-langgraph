    {
      "id": "claim_178d6134099547908050b3c3a88690b0",
      "statement": "SafeModelResponseMiddleware (awrap_model_call/_safe_model_response) projects every model response through to_safe_message, and whenever the resulting AIMessage includes a medical_lookup tool call it blanks any assistant content and drops all sibling tool calls, so no preamble text or concurrent member-data mutation can accompany a medical_lookup invocation in the same step.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/coach_agent.py#L106-L141",
          "version": "repo-lines-v1:sha256:86d6fb4eec13248593f0845db82af9b87db6616e0cd56f07e9e188d0029376a7:"
        }
      ]
    },
    {
      "id": "claim_2b1369d5a7564bdf96be787c22fac793",
      "statement": "A ToolCallLimitMiddleware bound to change_schedule with run_limit=1 restricts the agent to at most one change_schedule invocation per run, bounding how many times its interrupt-producing behavior can fire in a single turn.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/agent/coach_agent.py#L297-L301",
          "version": "repo-lines-v1:sha256:0177c7710c779a857abde684fdc48bdb0f44bb7a346e88b33ce4658a686cf127:"
        }
