        }
      ]
    },
    {
      "id": "claim_cbb7201c42234271b2e1abf67f027dda",
      "statement": "langgraph.json registers 'healthcare_rag' and 'coach' as two independent top-level graphs (./healthcare_rag/graph/__init__.py:graph and ./healthcare_rag/agent/__init__.py:coach respectively), so they are deployed and versioned separately even though the coach process invokes the healthcare graph in-process for medical answers.",
      "evidence": [
