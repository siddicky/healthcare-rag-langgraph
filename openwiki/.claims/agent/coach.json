    {
      "id": "claim_05fa29fbc5714191894a861ca6d9db52",
      "statement": "Route B's fixed tool catalog includes remember_fact, log_metric, log_injection, view_schedule, change_schedule, create_reminder, edit_reminder, cancel_reminder, compose_ui, medical_lookup, and copy_to_clipboard, and the base system prompt forbids self-generated medical answers, diagnoses, or personal dosing advice, requiring medical turns to call medical_lookup alone.",
