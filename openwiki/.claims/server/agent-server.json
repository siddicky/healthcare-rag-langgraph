        }
      ]
    },
    {
      "id": "claim_dc89a8202bd840f19056e634afb20156",
      "statement": "Native HTTP routes cover threads/state/copy, runs/wait/stream/join/cancel, ThreadStream commands/events, crons, store items, and a read-only assistants surface; when a custom HTTP app is configured (cfg.http_app) its Starlette routes are proxied ahead of native routes, and a catch-all route returns 501 only for enumerated documented-but-unimplemented paths while unmounted MCP/A2A surfaces return ordinary 404/405.",
      "evidence": [
        {
          "resource": "repo://server/app.py#L189-L210",
          "version": "repo-lines-v1:sha256:e553c59951d46ba37e85cc2da6356759282debb0c1a1710e2de8f676ffeffe99:"
