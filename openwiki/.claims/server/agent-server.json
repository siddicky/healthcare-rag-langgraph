        }
      ]
    },
    {
      "id": "claim_0a595699cae94e83832053d7b6c87c6b",
      "statement": "Cron records validate a croniter-compatible schedule and an IANA timezone at input time; the cron scheduler polls once per second, computes due crons, and enqueues their runs, leaving any cron that hits a run queue conflict to be retried on a later poll.",
      "evidence": [
        {
          "resource": "repo://server/crons.py#L53-L120",
          "version": "repo-lines-v1:sha256:5014804708c24c45b85c00b98890c6f258f442ef72407fa8bbd6c41b83014e9c:"
        }
