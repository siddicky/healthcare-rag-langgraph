    {
      "id": "claim_5b9c28298a394c1fa2085c289b7c7d86",
      "statement": "Per-thread run conflicts are resolved by multitask_strategy: reject raises RunConflict, interrupt cancels the active run first, and both queue the new run when a run is already active on the thread; the pending-run queue is bounded server-wide by QUEUE_LIMIT (100), and exceeding it raises QueueFull, surfaced by callers as HTTP 503 with a Retry-After header.",
      "evidence": [
        {
          "resource": "repo://server/crons.py#L205-L215",
          "version": "repo-lines-v1:sha256:2b7e8e923cac4b05d8dbc24e2e0c6e0fb29a72262a42565d249b40a18e670b33:"
