  "claims": [
    {
      "id": "claim_08acbb616e5646418e405e8536f00659",
      "statement": "server/ is a clean-room implementation of the LangGraph Agent Server surface hosting compiled graphs behind HTTP (not the base RAG GraphEngine), configured via langgraph.json which selects the RAG and coach graphs, the auth/custom HTTP modules, store embedding configuration, API version, and disables MCP/A2A.",
      "evidence": [
        {
          "resource": "repo://langgraph.json",
          "version": "repo-file-v1:sha256:edc19183e919a8a0e015dd62f264c85e4975ebf6acc521875c44d73147abde42"
        },
        {
          "resource": "repo://server/app.py#L129-L247",
          "version": "repo-lines-v1:sha256:42121dbcc3101cb6dea44267557e2a80a558f94219ccc157e0cdcc75cf62f104:"
        }
      ]
    },
    {
      "id": "claim_21c8ab01280c47c3a3b2f32ae0672832",
      "statement": "App lifespan (server/app.py create_app's lifespan context manager) creates storage, installs the local langgraph-api compatibility shim, reconciles interrupted runs and crons, loads/recompiles configured graphs against the shared saver/store, enters the custom app's own lifespan, creates the RunEngine and starts the cron scheduler, and marks each readiness subsystem ready in sequence; shutdown clears scheduler readiness, cancels the scheduler and in-flight runs, then exits the custom app lifespan and closes storage.",
      "evidence": [
        {
          "resource": "repo://server/app.py#L149-L188",
          "version": "repo-lines-v1:sha256:e0e4eb1d1dc2fa5224f17c01942dbe8766f843b85be0e862fdeb83e85cb6b96a:"
        }
      ]
    },
    {
      "id": "claim_37b9e6092bb54a088cd1ed6349d87aa1",
      "statement": "Readiness is tracked per named subsystem (config, graphs, auth, scheduler, custom_app, storage) via ReadinessState, and is only reported ready once every registered check is true, so /ok returns 503 until storage, graphs, the custom app, and the scheduler have all completed startup.",
      "evidence": [
        {
          "resource": "repo://server/app.py#L145-L188",
          "version": "repo-lines-v1:sha256:3a04220c1d60b98d8cc333c1be76e3d0458292fc2205e58f4d6e28481ecd4a63:"
