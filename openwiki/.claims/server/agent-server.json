    {
      "id": "claim_9bb97c9bb7684c999a99d2ffaaae5de4",
      "statement": "Run submission (RunEngine.submit) enforces exactly one of input or command via RunRequest's exactly_one_payload validator, strips any client-supplied langgraph_auth_user from persisted run config and injects the server-authenticated identity into the graph config instead, so a client can never forge the executing principal.",
      "evidence": [
        {
          "resource": "repo://server/run_engine.py#L267-L331",
          "version": "repo-lines-v1:sha256:4b76eb1619dec95c30337262a776f231c7a4b10aa4ed1f0b635186920186118c:"
