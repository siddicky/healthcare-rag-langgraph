    {
      "id": "claim_66566c1b19df4e5f924bf41633b3ffbf",
      "statement": "The read-only assistant surface (server/assistants.py) exposes POST /assistants/search, GET /assistants/{assistant_id}, and GET /assistants/{assistant_id}/graph; the graph endpoint applies the same assistants:read policy as the assistant record, resolves the configured raw graph, calls aget_graph(xray=...), and strips internal node data.id values from the JSON response so a member cannot use graph visualization to discover an unauthorized configured graph.",
      "evidence": [
        {
          "resource": "repo://server/assistants.py#L1-L98",
          "version": "repo-lines-v1:sha256:a5a289058fa9edb38b0da46f67af7044d8c368f728297302d71a4188410304f1:"
