        }
      ]
    },
    {
      "id": "claim_b86a17e912b4423d85c9c490acf440b4",
      "statement": "Cancelling a running run with action=rollback restores the thread's pre-run checkpoint state (deletes the thread's checkpoints and reapplies the pre-execution values), while action=interrupt just cancels the run's scope; graph exceptions during execution are caught and recorded as run status error, and process shutdown marks queued and active runs interrupted.",
      "evidence": [
        {
          "resource": "repo://server/run_engine.py#L254-L266",
          "version": "repo-lines-v1:sha256:fe3684628cbd9da0c371e64fec00f34a53a023b1088c97c3cd86c6a23f3f79ca:"
