    {
      "id": "claim_137c86f61eb647328ea37bf96bbed389",
      "statement": "`evaluate_retrieval` sends merged retrieval context to the `retrieval_evaluation` prompt and only triggers one capped gap-fill round when the parsed result has `is_sufficient=False`, `additional_queries` nonempty, and no gap round has run yet (`gap_round == 0`); additional queries are capped at three per round.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/nodes/evaluate.py#L41-L85",
          "version": "repo-lines-v1:sha256:96595607e48b7b206c242d82bc6b90303bf18c4f2b9d244582334500a0f289ca:"
