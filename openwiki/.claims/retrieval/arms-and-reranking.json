    {
      "id": "claim_4991d0a0d7f14b6f9decdcf7e4af18ea",
      "statement": "The PageIndex arm (healthcare_rag/processors/pageindex_retrieval.py) issues one structured LLM call (pageindex_select prompt to PageIndexSelection) that reads a compact rendered outline of a monograph's section tree and selects up to HC_RAG_PAGEINDEX_MAX_NODES (default 4) node ids via select_nodes/render_outline.",
      "evidence": [
