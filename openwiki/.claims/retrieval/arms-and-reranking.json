    {
      "id": "claim_b67f1b26e728420cae5ece0c655f4f89",
      "statement": "Each retrieval arm declares the SDK exception class worth retrying: Weaviate and PageIndex arms retry WeaviateBaseError (PageIndex keeps this purely for byte-identical retry behavior since it opens no client), and the Pinecone arm retries PineconeException; retrieve_documents retries up to three attempts with 1s/2s backoff.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/nodes/retrieve.py#L140-L149",
          "version": "repo-lines-v1:sha256:91b0fe5ab416270aff33a1f1f57148fb3e9672bbe9579ac4a9ccb5d9384ccdf7:"
