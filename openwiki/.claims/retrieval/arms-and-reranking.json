    {
      "id": "claim_4610e362312e4b98bc9c64692c21d46d",
      "statement": "PageIndex, Pinecone, and reranking are opt-in experimental retrieval arms, not the production default: the PageIndex-vs-Weaviate decision record and the Pinecone/rerank decision record both verdict REJECT, keeping Weaviate hybrid search (limit=4, alpha=0.65, relative-score fusion) as the retrieval stage with no reranker by default.",
      "evidence": [
        {
          "resource": "repo://docs/decisions/pageindex-vs-weaviate.md#L1-L7",
          "version": "repo-lines-v1:sha256:2545d3bf53d2fe2402f9822a28388ba1ce8564eda58c4440dd248515093f5c54:"
