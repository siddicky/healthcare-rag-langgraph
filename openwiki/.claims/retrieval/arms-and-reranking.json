  "claims": [
    {
      "id": "claim_a52b822638534d79a0b38766b43b27ae",
      "statement": "The default retrieval backend is Weaviate hybrid search; the retrieve_documents node resolves the active arm from GraphSettings.retriever via _ARMS/resolve_arm, so routing, merge, gap-fill, citations, and every downstream stage are unchanged across arms.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/nodes/retrieve.py#L34-L57",
          "version": "repo-lines-v1:sha256:1a7a1f4848e0a2d30661c2e2ff8ef4f3aeb9ad9a4f494a99653402fc9024ba84:"
        }
      ]
    },
    {
      "id": "claim_9b430dec06b047b7a8777f336e3c4f08",
      "statement": "HC_RAG_RETRIEVER selects the retrieval arm (weaviate default, pageindex, pinecone); an unknown arm name raises ValueError from resolve_arm, and an explicitly injected Resources.hybrid_search (used by tests/fixtures) always wins over the settings knob.",
