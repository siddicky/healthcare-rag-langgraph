    {
      "id": "claim_c769d42d54b64c83acb6ac498a88d3d8",
      "statement": "scrub_phi delegates entirely to the process-wide PrivacySanitizer (get().privacy.scan) rather than running its own regexes, and is fail-closed: initialization or scan errors raise PrivacyScanError and abort the turn, so contains_phi reflects only what the deterministic sanitizer found and is independent of the LLM call.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/engine.py#L69-L74",
          "version": "repo-lines-v1:sha256:efcc574ac230ca9b68a3b5bb187e2752709fb081834b1fbe3f168b7c6ce409d8:"
