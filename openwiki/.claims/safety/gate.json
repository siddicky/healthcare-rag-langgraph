    {
      "id": "claim_1dd24e551cac4e01b1fa7e2a516baea9",
      "statement": "When HC_RAG_REFUSAL_BOUNDARY is true (default), a gate refusal of kind personal_advice, emergency, or injection is persisted into checkpoint state RAGState.refusal_boundaries as a RefusalBoundary carrying kind, a derived topic, a byte-exact template drawn from allowed_responses(kind) (never the classifier's own text; a fallback template is substituted otherwise), a UTC created_ts, and the current TEMPLATE_VERSION; upsert_boundary replaces any boundary with the same key and appends the new one.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/nodes/safety.py#L182-L216",
          "version": "repo-lines-v1:sha256:787ef5bc8a71c26cae2189a25d5116aea6baf5b33c23aee2d00fc622d326fea3:"
        },
