    {
      "id": "claim_b6b9d4f7440340d98b4fe1a64b8f2681",
      "statement": "scrub_phi delegates every call to the single process-wide PrivacySanitizer, which unions a Presidio NER pass, a deterministic clinical-identifier pattern set, and a clinical-code preserve carve-out, replacing matches with [REDACTED_<KIND>] tokens; a scan failure (initialization error, scanner exception, or over-16 KiB input) is fail-closed and aborts the turn rather than passing raw text through.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/processors/privacy.py",
