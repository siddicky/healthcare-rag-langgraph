  "claims": [
    {
      "id": "claim_af7fb5647a744833a2af7e857f9f9e3e",
      "statement": "Every query passes the safety_gate node before retrieval or generation, which OR-es deterministic no-network pre-checks (PHI, instruction-override phrasing, identifier-recall requests, first-person emergency red flags) with one LLM classification call, where the deterministic layer can only escalate a decision, never relax it.",
      "evidence": [
        {
          "resource": "repo://docs/safety.md#L20-L36",
          "version": "repo-lines-v1:sha256:ca4d7d8b07d7e1e3f8be38528d203c67696284771571b9f3ee88241f287c3b3b:"
        },
        {
