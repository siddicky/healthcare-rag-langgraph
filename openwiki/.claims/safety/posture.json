          "version": "repo-file-v1:sha256:717a0eb31ee40432895d342955c0a251eec2203378ec978cce3ad252cbfd7272"
        }
      ]
    },
    {
      "id": "claim_9129b6a87d824d879f6744e4f55cf75f",
      "statement": "Four safety-gate categories (emergency_red_flag, personal_medical_advice, out_of_scope, prompt_injection) short-circuit the turn to a fixed plain-Python refusal/redirect template with follow_ups = [] and no retrieval; personal_medical_advice refusals are terminal for that turn.",
      "evidence": [
        {
          "resource": "repo://docs/safety.md#L88-L98",
