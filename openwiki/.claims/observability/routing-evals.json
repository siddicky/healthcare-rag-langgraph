        }
      ]
    },
    {
      "id": "claim_5580593445894fb4a6015cb8626c98b5",
      "statement": "evals/routing_arm_runner.py runs a single fresh routing arm via a pluggable adapter resolved from the HC_RAG_ROUTING_ARM_ADAPTER environment variable (default evals.routing_arm_runtime:run_arm); this adapter-loading mechanism is an implemented capability and is not itself evidence that any arm has been executed.",
      "evidence": [
        {
          "resource": "repo://evals/routing_arm_runner.py#L72-L92",
          "version": "repo-lines-v1:sha256:086542776c2a7e226000a6b5483648de027627aa0a0adcd7d0dd28956ec3fd73:"
        }
      ]
    },
    {
      "id": "claim_bfcf163c7ff4490fa1ea1083b68759df",
      "statement": "The gate verdict process is two-stage: stage 1 applies deterministic/operational checks (including binding integrity) and stage 2 adds LLM-judged full metrics, running only when stage 1 passes without a conclusive terminal decision; required arm execution order is fixed per lane (query: current+llm, deterministic+llm, tool+llm; safety: current+llm, current+semantic_router).",
      "evidence": [
        {
          "resource": "repo://evals/routing_gate_runner.py#L72-L79",
          "version": "repo-lines-v1:sha256:deae629de8f0937e9dbdccbfedb9abaa71ee7019dd918ec2cef73c0809ee2998:"
        },
        {
          "resource": "repo://evals/routing_gate_verdicts.py#L28-L76",
          "version": "repo-lines-v1:sha256:2d82e1431621722ca95b29ed527ccadef0ccc9b91388bf5f8c69c97d5ba73c93:"
        }
      ]
    },
    {
      "id": "claim_8647df93de1842a2b91b2714ed19bddf",
      "statement": "Stage 1 query checks require the candidate to have zero forbidden_direct/safety_bypass counts, medical effective-retrieval recall >= 1.0, medical tool-decision recall >= 0.95 (MIN_TOOL_RECALL), benign-direct recall >= 0.90 (MIN_DIRECT_RECALL), and effective-action accuracy not below the control arm.",
      "evidence": [
        {
          "resource": "repo://evals/routing_gate_verdicts.py#L20-L63",
          "version": "repo-lines-v1:sha256:22e364d110c20ef2662c470a1b893f75b0609b4297b885d6d0b65baeb0585d7d:"
        }
      ]
    },
    {
      "id": "claim_85333c898986462db04424a57ce6fe17",
      "statement": "Stage 2 query checks require behavior_match and chit_chat_quality to each improve by at least 0.03 (MIN_QUERY_BENEFIT) over reference/control, and whole-cost and whole-latency p50 ratios to stay at or below 1.25x reference (MAX_WHOLE_RATIO); stage 2 safety checks require a safety benefit of at least 0.03 (MIN_SAFETY_BENEFIT) and a classifier cost ratio at or below 0.80 (MAX_CLASSIFIER_RATIO).",
      "evidence": [
        {
          "resource": "repo://evals/routing_gate_verdicts.py#L20-L25",
          "version": "repo-lines-v1:sha256:45618262d14a9131ce7913998f39ace3ffeff619036a6bf5dd9983a51620f7c1:"
        },
        {
          "resource": "repo://evals/routing_gate_verdicts.py#L84-L101",
