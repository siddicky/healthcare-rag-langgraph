    {
      "id": "claim_727681a854a1452baff696a47b6c652e",
      "statement": "evals/routing_gate.py builds two independent paired go/no-go gates selected via --lane query|safety: the query lane compares reference current+llm, control deterministic+llm, and candidate tool+llm; the safety lane compares reference current+llm and candidate current+semantic_router.",
      "evidence": [
        {
          "resource": "repo://evals/routing_gate.py#L39-L46",
          "version": "repo-lines-v1:sha256:1d545be988545403aeaddb1d5e2761bd4bc2e8d8ffe77ab5e9fbc396c00219f8:"
        },
        {
          "resource": "repo://evals/routing_gate_runner.py#L72-L79",
          "version": "repo-lines-v1:sha256:deae629de8f0937e9dbdccbfedb9abaa71ee7019dd918ec2cef73c0809ee2998:"
        }
      ]
    },
    {
      "id": "claim_0c0d9fe2315949578b97f25bb223334e",
      "statement": "The arm identity used for gating is reconstructed from the environment manifest (HC_RAG_QUERY_RESPONSE_ARM x HC_RAG_SAFETY_CLASSIFIER) via binding_from_manifest rather than trusted from the report, and a combined or lane-contaminated arm combination is treated as a hard error.",
      "evidence": [
        {
          "resource": "repo://evals/routing_gate_runner.py#L20-L27",
          "version": "repo-lines-v1:sha256:05e3f4cea844d30c120169cadd2ff67fe87fcd89036da63f48f2e53ef5ddc8ee:"
        },
