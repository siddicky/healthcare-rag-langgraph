        }
      ]
    },
    {
      "id": "claim_bd30306883d74c29b1796b606941cfce",
      "statement": "Binding-integrity invariant: all arms in one gate run must share the same git SHA, artifact hash, row-ID population, repetitions, and concurrency, or the run is rejected as an ERROR verdict via routing_gate_checks.binding_failures before any stage-1 or stage-2 evaluation is trusted.",
