    {
      "id": "claim_968f6df9dd624978a578640ae041f4eb",
      "statement": "The deterministic pattern layer (privacy_patterns.py) is a cue-bound floor covering contact fields (email, phone, postal code, street address), biographic fields (cued names, DOB, admission/discharge/appointment/visit/encounter event dates), and healthcare/administrative record identifiers (health card, MRN, patient account, claim, prior authorization, prescription, referral, accession/specimen/lab-order, encounter, device serial, vehicle/plate identifiers), each firing only next to its labelling cue word so free-standing numbers are left alone.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/processors/privacy_patterns.py#L25-L113",
          "version": "repo-lines-v1:sha256:5ca05be1da7c34d46a2b90dbd62e9aa3f87ff161ccbfe94e9fe1b1837f06a21c:"
        }
