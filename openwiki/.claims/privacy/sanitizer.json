    {
      "id": "claim_52d97649299244f0991cfd2e8f4e4f03",
      "statement": "PrivacySanitizer has a fail-closed lifecycle: initialize() moves UNINITIALIZED -> INITIALIZING -> READY only after the analyzer is built and _validate passes (pinned presidio-analyzer==2.2.364, spacy==3.8.15, en_core_web_sm==3.8.0, full ENTITY_TYPES inventory, and a sentinel scan finding PERSON and IP_ADDRESS); any mismatch or exception moves the singleton to FAILED permanently, and a concurrent Condition variable makes overlapping initializers wait rather than race.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/processors/privacy.py#L134-L159",
          "version": "repo-lines-v1:sha256:720d31538db2e872c0edc6e7296235ebccc18fa1a22b64db394cd9567503c091:"
