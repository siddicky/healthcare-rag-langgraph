    {
      "id": "claim_4704cac4f796451596db2e51d9f17866",
      "statement": "PrivacySanitizer (healthcare_rag/processors/privacy.py) is the single process-wide recognizer of personal identifiers; scrub_phi in healthcare_rag/processors/safety_signals.py delegates to get().privacy.scan(text), so the safety gate, graph nodes, history scrubbing, the CLI monitor, and the coach agent's persistence writes all redact through the same analyzer, owned by a single injectable Resources.privacy instance.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/resources.py#L37-L144",
          "version": "repo-lines-v1:sha256:e22edee027ea51877c019e4e646a4e35fcef01522bc798275075ba8a44c409ae:"
