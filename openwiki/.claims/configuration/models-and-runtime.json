    {
      "id": "claim_3afb8c60873240cdb6741fd1c7b78cbc",
      "statement": "sampling_params(model, temperature, reasoning_effort) exists because GPT-5.x/o-series reasoning models reject temperature/top_p unless reasoning_effort=\"none\" while gpt-4o-family models only accept temperature; it converts one desired-temperature input into the kwargs a given model name actually accepts so a model can be swapped from configuration without changing call sites.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/services/model_sampling.py#L30-L48",
          "version": "repo-lines-v1:sha256:332dd054e4d9566a04f3b0b15f17b777781db79a90be85ec4f3196f28f5694f5:"
