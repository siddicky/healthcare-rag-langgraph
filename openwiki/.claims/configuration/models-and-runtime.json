    {
      "id": "claim_def311bb92ee4171b3dbfff979f3e78c",
      "statement": "A safe model or runtime configuration change follows a defined procedure: scope the single change and retain rollback; validate a fresh GraphSettings snapshot and capture GraphEngine.describe(); keep calls behind LangChainLLMGateway and rerun tests/test_model_sampling.py after sampling-logic changes; exercise settings/routing tests and other focused tests for the modified control; evaluate with a fresh baseline-vs-treatment comparison rather than reusing an old evaluation or safety-gate acceptance, since changing the default or validator model changes what the safety gate sees and what the judge grades; then roll out while monitoring initialization, credential, and outcome telemetry.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/llm.py#L58-L87",
          "version": "repo-lines-v1:sha256:1953c46d5b5819d4f06ba785bf212a921afae43e8a85a70f9608a229b66ade37:"
