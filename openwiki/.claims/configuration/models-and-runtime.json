        }
      ]
    },
    {
      "id": "claim_0e97bb0c66b242e79e646fa2259c0ba6",
      "statement": "is_reasoning_model treats any model name starting case-insensitively with gpt-5, o1, o3, or o4 as a reasoning model; for such a model, sampling_params always sends reasoning_effort and sends the supplied temperature only when the effective effort is \"none\", for o-series models an effort of \"none\" is converted to \"low\" (so o-series never receives temperature), and non-reasoning models receive only the supplied temperature with no reasoning parameter.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/services/model_sampling.py#L25-L48",
