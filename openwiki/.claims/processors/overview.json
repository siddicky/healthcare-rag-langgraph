        }
      ]
    },
    {
      "id": "claim_1da572ed2d03419b997707d1bd2ef3c7",
      "statement": "SafetyGate.assess ORs the LLM-classified category with deterministic regex pre-checks (red_flag_terms, injection_flags) that can only escalate the outcome (emergency_red_flag > prompt_injection > whatever the LLM said), never relax it, and falls back to a safe default SafetyAssessment if the LLM call fails.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/processors/safety.py#L128-L186",
          "version": "repo-lines-v1:sha256:a7d7acaa9ef0e9c8581b7c55583fc1a3485e8af8da4b6112973c8874c8095f43:"
        }
      ]
    },
    {
      "id": "claim_7e72983cf1fa4b4b99c92cc485b64fbb",
      "statement": "SafetyGate._evaluate short-circuits into templated responses per category (injection, emergency, identifier_recall, personal_advice, out_of_scope) and, for a detected prompt-injection attempt, performs one recursive re-evaluation pass over the residual text after stripping the injected instruction (capping the safety stage at two LLM calls per turn).",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/processors/safety.py#L188-L283",
          "version": "repo-lines-v1:sha256:1b26b44f5f67f00f8121a959cb61dfdce192b30b30889d25af597bbb94944e4b:"
        }
