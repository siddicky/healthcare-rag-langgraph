  "claims": [
    {
      "id": "claim_99f2fa65f0ca4a42a53337db04b2b9dd",
      "statement": "PromptRegistry (healthcare_rag/graph/prompts.py) renders healthcare_rag/prompts/<file>.yaml.j2 templates through Jinja, YAML-loads the rendered messages, and converts them into LangChain SystemMessage/HumanMessage objects; STAGE_FILES maps stage names to template stems and RESPONSE_MODELS pins each structured stage's Pydantic response model.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/prompts.py#L28-L79",
          "version": "repo-lines-v1:sha256:153a1b91db8d1515af3d72ddf9c0b7ce7a528e288b2e9b9aecdcb7b5338e3b29:"
        }
      ]
    },
    {
      "id": "claim_9ccc90c79c4f4e148303412fc8076048",
      "statement": "LangChainLLMGateway (healthcare_rag/graph/llm.py) executes stages through astructured (with_structured_output, method=\"json_schema\", strict when HC_RAG_STRUCTURED_STRICT), acomplete (plain text), aroute_tools (tool-calling retrieval routing), and aquery_or_respond (bound retrieve_monographs tool call); astructured and acomplete each catch any exception and return the caller-supplied default.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/llm.py#L109-L200",
          "version": "repo-lines-v1:sha256:38d05bcd650fd66f0a9b62412405ed3d443964e2c3a6fd42a28fc5402e793a95:"
        }
      ]
    },
    {
      "id": "claim_e7d5999a008a458a94f5cd89777bbfa0",
      "statement": "sampling_params (healthcare_rag/services/model_sampling.py) adapts temperature/reasoning_effort kwargs per model family: reasoning models (gpt-5.x/o-series) get reasoning_effort and only receive temperature when effort is \"none\"; non-reasoning models just get temperature.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/services/model_sampling.py#L1-L48",
          "version": "repo-lines-v1:sha256:e159003ca85c0cf26263652b61ba548a70c3b3575bf1c9831721f2ec21937a91:"
        }
      ]
    },
    {
      "id": "claim_fb370e1ee1b24338bc796b104954a701",
      "statement": "safety_gate is the first node on every turn (nodes/safety.py), calling processors/safety.py's SafetyGate.evaluate via nodes/safety_classifier.py's LangChainSafetyGate (which runs the safety_gate.yaml.j2 template against SafetyAssessment at temperature 0.0 on the default model tier) and returning a Command that routes via route_after_gate.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/nodes/safety.py#L64-L262",
          "version": "repo-lines-v1:sha256:b1ec7391d9108ee203db12100c2d258e558536e33572a494e806fcd53f3f98c2:"
