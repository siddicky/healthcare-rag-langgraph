  "claims": [
    {
      "id": "claim_417310ce3b6841f7a0fbdcbfcaa6416e",
      "statement": "AnswerValidator.structure_and_validate_async takes the generated plain answer, its retrieval bundle, formatted docs, and the doc_N-to-original-id prompt_id_map, calls a structuring LLM to produce CitedAnswerResult(statements=[StatementWithCitations]) where each citation has doc_id, source_name, and quote, and validation.py orchestrates find_source_citations/reconstruct_source_answer (validation_source.py), resolve_citation_ids/validate_citations_and_build_answer (validation_citations.py), and formatting helpers plus FALLBACK_MESSAGE (validation_rendering.py).",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/models/answers.py",
          "version": "repo-file-v1:sha256:5a61fce55daa7de61cd145d80cd25c336c66b8dddb32cb4399877ec44d038985"
        },
        {
