    },
    {
      "id": "claim_0e3e3185aa034ea9a5f258f427cb4082",
      "statement": "find_source_citations scans the raw plain-answer text (not the structured LLM output) for [doc_N] markers and classifies it as SourceCitations, None (no markers), or UnsafeSourceScaffold when the text begins with leaked scaffolding ('Documents for citation context:', 'Document ID:', or a SYSTEM line); reconstruct_source_answer only succeeds when the structured answer's citation IDs exactly match the IDs found in the raw text, otherwise it returns None to detect prompt/response tampering.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/processors/validation_source.py#L13-L67",
          "version": "repo-lines-v1:sha256:fe25f8cb35d8cd24fd4c03b374d804af6da89e6e861edbc6f2253ccaaa41d924:"
        }
      ]
    },
    {
      "id": "claim_2cdbbd574db9465a84dbe19e5f4582bf",
      "statement": "In structure_and_validate_async, an UnsafeSourceScaffold classification, a None classification (no citation markers), or a None result from reconstruct_source_answer (ID mismatch) each cause the whole answer to be replaced with FALLBACK_MESSAGE regardless of what the structuring LLM returned.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/processors/validation.py#L96-L120",
          "version": "repo-lines-v1:sha256:dd78b81bc618c71ab4219f8c3c44fa76a2b0b106318c49a571bbcc7f7b70862d:"
        }
      ]
    },
    {
      "id": "claim_263d6531a7cc452a9c270039da677912",
      "statement": "format_documents_for_prompt assigns each retrieved QueryDocument a throwaway prompt ID doc_1, doc_2, ... in retrieval order and returns a prompt_id_to_original_id_map that is threaded through generation state as prompt_id_map; resolve_citation_ids uses this map to replace each citation's temporary doc_N with its original document id before validation, and an unresolved prompt id is left as the literal doc_N string.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/graph/nodes/generate.py#L33-L48",
