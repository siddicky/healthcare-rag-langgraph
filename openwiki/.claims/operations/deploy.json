    {
      "id": "claim_6655df328156482fb284af5890e527bf",
      "statement": "docs/decisions/release-tags-and-rollback.md defines a release as the immutable triple (git tag, image digest, that tag's deploy/fly.prod.toml); the git tag is the immutable release identity, the {{version}} GHCR image tag is the ledger mapping a tag to a digest, and only a validated sha256:... digest is ever deployed, never latest or a rolling tag. Rolling back redeploys the whole triple together so an old image is never paired with a newer storage configuration.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy.yml#L512-L528",
          "version": "repo-lines-v1:sha256:a3d6fcf99abd31647864845303f26701185b9e5a20fb3fded992d08b64c539bb:"
