    {
      "id": "claim_afc5c5a5383a4ca7be82ea2cefda81bd",
      "statement": "The local Weaviate Compose service exposes HTTP 8080 and gRPC 50051, persists data to a named `weaviate_data` volume, enables anonymous access, and sets `restart: on-failure:0`, meaning Docker will not automatically retry the container after a failure — operators must explicitly restart it (e.g. `make weaviate` or `docker compose up -d`).",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L1-L29",
