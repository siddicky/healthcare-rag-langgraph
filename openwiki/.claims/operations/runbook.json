    {
      "id": "claim_9d45a68498384285854e51a562a7f0da",
      "statement": "The interactive CLI hides implementation detail on initialization failure: `interactive_main()` catches any exception from `build_engine()` and prints only the fixed string `PRIVACY_OR_RUNTIME_INITIALIZATION_FAILED` with a nonzero exit code, without a traceback or the offending config value; this behavior is enforced by a subprocess-based test (`tests/test_cli_interactive.py`) that runs the module end to end and asserts on the exit code, the fixed message, and the absence of both `Traceback` and the injected bad config value.",
      "evidence": [
        {
          "resource": "repo://healthcare_rag/cli/interactive.py#L57-L62",
          "version": "repo-lines-v1:sha256:7cc136e762b1b1c436dbbb33e9600b5bdefc2e56f1a2224b8a41fd2db8d9e40c:"
        },
